# Copy to configs/paths.env and replace /path/to/... with absolute local paths.
# The root launchers automatically source this file. Existing environment overrides win.
export NEURIPS_ROOT="${NEURIPS_ROOT:-/path/to/WeatherPrompt}"
export XVLM_ROOT="${XVLM_ROOT:-$NEURIPS_ROOT/XVLM/X-VLM-master}"
export BERT_MODEL="${BERT_MODEL:-/path/to/bert-base-uncased}"
export SWIN_CHECKPOINT="${SWIN_CHECKPOINT:-/path/to/swin_base_patch4_window7_224_22k.pth}"
export TRAIN_DIR="${TRAIN_DIR:-/path/to/University-Release/train}"
# Use the IJCV training captions; do not silently substitute the NeurIPS caption bank.
export TRAIN_CAPTIONS="${TRAIN_CAPTIONS:-/path/to/multiweather_captions_twosent.json}"
export TEST_DIR="${TEST_DIR:-/path/to/University-Release/test}"
# For MODEL_SOURCE=archive: place net_209.pth and its opts.yaml together here.
export ARCHIVE_DIR="${ARCHIVE_DIR:-/path/to/75.85-checkpoints}"
# RUN_DIR is optional: defaults to IJCV/runs/75.85, relative to the launcher location.
# export RUN_DIR="${RUN_DIR:-/path/to/ijcv_runs/75.85}"
export GPU_IDS="${GPU_IDS:-0}"
export DEVICE="${DEVICE:-cuda:0}"
export PYTHON="${PYTHON:-python}"
export IJCV_DIST_URL="${IJCV_DIST_URL:-tcp://127.0.0.1:12346}"
